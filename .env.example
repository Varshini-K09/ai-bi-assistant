# ---- LLM provider: ollama | gemini | none -------------------------------
# ollama  -> local open-source model, 100% free, no account, no API key
# gemini  -> Google AI Studio free tier (needs a free API key)
# none    -> no LLM at all, deterministic rule-based interpreter only
LLM_PROVIDER=ollama

# Ollama (default)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Gemini (optional). Free-tier model names change; check https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Seconds to wait for the LLM before falling back to the rule-based interpreter
LLM_TIMEOUT_SECONDS=60
